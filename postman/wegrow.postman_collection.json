{
  "info": {
    "name": "WeGrow API",
    "description": "Base URL: http://localhost:8081/wegrow\n\nStart Payara with:\nasadmin --port 4849 start-domain\n\nMariaDB: wegrow database on localhost:3306",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8081/wegrow/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["wegrow", "api", "health"]
        }
      }
    },
    {
      "name": "List departments (with employee count)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8081/wegrow/api/departements",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["wegrow", "api", "departements"]
        },
        "description": "Expect 200 with [{id, name, description, employeeCount}], alphabetical by name. Empty database gives []."
      }
    },
    {
      "name": "Create department",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"IT\",\n  \"description\": \"IT department\"\n}\n"
        },
        "url": {
          "raw": "http://localhost:8081/wegrow/api/departements",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["wegrow", "api", "departements"]
        },
        "description": "Expect 201 with id. If the name already exists: 409."
      }
    },
    {
      "name": "Create department - duplicate name (409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"IT\",\n  \"description\": \"Duplicate department\"\n}\n"
        },
        "url": {
          "raw": "http://localhost:8081/wegrow/api/departements",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["wegrow", "api", "departements"]
        },
        "description": "Send twice: the second call answers 409."
      }
    },
    {
      "name": "Create department - missing name (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{}\n"
        },
        "url": {
          "raw": "http://localhost:8081/wegrow/api/departements",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["wegrow", "api", "departements"]
        }
      }
    },
    {
      "name": "Create department - form-data",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Finance", "type": "text" },
            { "key": "description", "value": "Finance department", "type": "text" }
          ]
        },
        "url": "http://localhost:8081/wegrow/api/departements",
        "description": "Let Postman generate Content-Type and its boundary automatically. Expect 201, or 409 if the name already exists."
      }
    },
    {
      "name": "Delete department by id",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:8081/wegrow/api/departements/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["wegrow", "api", "departements", "1"]
        },
        "description": "Expect 204 empty body. 404 unknown id, 409 if the department still has employees (change the id)."
      }
    }
  ]
}
